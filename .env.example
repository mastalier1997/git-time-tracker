# Optional Jira integration (read-only). Copy to .env and fill in.
# Self-hosted Jira: create a Personal Access Token in Jira under
#   Profile -> Personal Access Tokens.
# The app works without these — they only enable ticket links + status.

JIRA_BASE_URL=https://jira.example.com
JIRA_TOKEN=your-personal-access-token

# BMD Web auto-fill (bmd-fill.js). Used only by `npm run bmd`.
BMD_URL=https://asp.bmd.at/bmdweb2_<tenant-id>/bmdweb2.dll/
BMD_USER=your-bmd-username
BMD_PASSWORD=your-bmd-password
# Optional: day start time and BMD Buchungsart (1 = Normalbuchung)
BMD_DAY_START=08:00
BMD_BUCHART=1
# Buchungsart for the 30 min lunch break on days over 6h (12 = Pause)
BMD_PAUSE_BUCHART=12
